<?xml version="1.0" encoding="utf-8"?>
<!-- Material "Next image" widget. Padding is set at runtime from Settings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_m_bg"
    android:clipToOutline="true"
    android:contentDescription="Next wallpaper">
    <!-- Padding from Settings is applied as this frame's margin, in dp, so the launcher scales it for its own screen. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_next"
            android:tint="@color/widget_m_fg"
            android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
